{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "description": "快速启动器窗：仅应用搜索/启动 + 隐藏（D-28 最小授权）",
  "windows": [
    "launcher"
  ],
  "permissions": [
    "allow-desktop-launcher-launch",
    "allow-desktop-launcher-search",
    "allow-host-log",
    "allow-host-system-accent",
    "core:default",
    "core:window:allow-hide"
  ]
}
