{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pin",
  "description": "贴图窗：仅贴图读写/关闭 + 拖动与缩放（D-28 最小授权）",
  "windows": [
    "pin",
    "pin-*"
  ],
  "permissions": [
    "allow-host-log",
    "allow-host-system-accent",
    "allow-screenshot-pin-close",
    "allow-screenshot-pin-get",
    "allow-screenshot-pin-update",
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging"
  ]
}
