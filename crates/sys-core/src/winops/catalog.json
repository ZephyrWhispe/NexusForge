        {
          "type": "registry",
          "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\System",
          "value_name": "EnableActivityFeed",
          "value_type": "dword",
          "data": { "dword": 0 }
        },
        {
          "type": "registry",
          "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\System",
          "value_name": "PublishUserActivities",
          "value_type": "dword",
          "data": { "dword": 0 }
        },
        {
          "type": "registry",
          "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\System",
          "value_name": "UploadUserActivities",
          "value_type": "dword",
          "data": { "dword": 0 }
        }
      ]
    },
    {
      "id": "privacy_copilot_off",
      "name": "关闭 Windows Copilot",
      "category": "privacy",
      "description": "通过 HKCU 策略键隐藏任务栏 Copilot 按钮并禁用 Copilot（Win11 23H2）",
      "actions": [
        {
          "type": "registry",
          "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\WindowsCopilot",
          "value_name": "TurnOffWindowsCopilot",
          "value_type": "dword",
          "data": { "dword": 1 }
        },
        {
          "type": "registry",
          "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value_name": "ShowCopilotButton",
          "value_type": "dword",
          "data": { "dword": 0 }
        }
      ]
    },
    {
      "id": "privacy_recall_off",
      "name": "关闭 Recall（Windows AI 回顾）",
      "category": "privacy",
      "description": "通过 HKLM 策略键禁用 Recall 的 AI 快照分析（Win11 24H2 Copilot+ PC）。需管理员权限：应用时将弹出 UAC 授权，由提权辅助进程写入",
      "requires_admin": true,
      "actions": [
        {
          "type": "registry",
          "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
          "value_name": "DisableAIDataAnalysis",
          "value_type": "dword",
          "data": { "dword": 1 }
        }
      ]
    },
    {
      "id": "privacy_diagtrack_off",
      "name": "禁用诊断跟踪服务（DiagTrack）",
      "category": "privacy",
      "description": "将 Connected User Experiences and Telemetry 服务启动类型改为禁用。需管理员权限；修改系统服务可能影响遥测相关的官方诊断能力",
      "requires_admin": true,
      "actions": [
        {
          "type": "service",
          "name": "DiagTrack",
          "start_type": "disabled"
        }
      ]
    },
    {
      "id": "privacy_telemetry_tasks_off",
      "name": "禁用遥测相关计划任务",
      "category": "privacy",
      "description": "禁用兼容性数据收集（Compatibility Appraiser/ProgramDataUpdater）与客户体验改善计划（Consolidator/UsbCeip）四个系统计划任务。需管理员权限；系统更新可能重新启用",
      "requires_admin": true,
      "actions": [
        {
          "type": "task",
          "path": "\\Microsoft\\Windows\\Application Experience\\Microsoft Compatibility Appraiser",
          "enabled": false
        },
        {
          "type": "task",
          "path": "\\Microsoft\\Windows\\Application Experience\\ProgramDataUpdater",
          "enabled": false
        },
        {
          "type": "task",
          "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\Consolidator",
          "enabled": false
        },
        {
          "type": "task",
          "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\UsbCeip",
          "enabled": false
        }
      ]
    },
    {
      "id": "update_disable_auto",
      "name": "关闭 Windows 自动更新",
      "category": "update",
      "description": "通过组策略键禁止自动下载/安装更新（WUB 式；安全更新也一并暂停，请自行承担风险）。同时禁用 Windows Update 服务。需管理员权限；系统更新周期可能将此设置改回（回归时会在启动检测中提示）",
      "requires_admin": true,
      "actions": [
        {
          "type": "registry",
          "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
          "value_name": "NoAutoUpdate",
          "value_type": "dword",
          "data": { "dword": 1 }
        },
        {
          "type": "registry",
          "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
          "value_name": "AUOptions",
          "value_type": "dword",
          "data": { "dword": 2 }
        },
        {
          "type": "service",
          "name": "wuauserv",
          "start_type": "disabled"
        }
      ]
    },
    {
      "id": "update_exclude_driver",
      "name": "更新排除驱动程序",
      "category": "update",
      "description": "阻止 Windows Update 通过质量更新推送驱动程序（设备驱动改由厂商/设备管理器管理）。需管理员权限",
      "requires_admin": true,
      "actions": [
        {
          "type": "registry",
          "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "value_name": "ExcludeWUDriversInQualityUpdate",
          "value_type": "dword",
          "data": { "dword": 1 }
        }
      ]
    },
    {
      "id": "update_clear_cache",
      "name": "清理 Windows 更新缓存",
      "category": "update",
      "description": "停止 Windows Update 服务后清空更新下载缓存（SoftwareDistribution\\Download），用于修复更新卡死/失败。属维护操作，可重复执行；完成后服务恢复运行",
      "requires_admin": true,
      "maintenance": true,
      "actions": [
        {
          "type": "service",
          "name": "wuauserv",
          "action": "stop"
        },
        {
          "type": "service",
          "name": "bits",
          "action": "stop"
        },
        {
          "type": "file_clean",
          "path": "C:\\Windows\\SoftwareDistribution\\Download",
          "recursive": true,
          "skip_recent_hours": 0
        },
        {
          "type": "service",
          "name": "wuauserv",
          "action": "start"
        },
        {
          "type": "service",
          "name": "bits",
          "action": "start"
        }
      ]
    },
