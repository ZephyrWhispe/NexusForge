      "requires_admin": true,
      "maintenance": true,
      "actions": [
        { "type": "empty_working_set" }
      ]
    },
    {
      "id": "maintenance_dism_scanhealth",
      "name": "DISM 组件存储健康检查",
      "category": "maintenance",
      "description": "DISM /ScanHealth：扫描组件存储损坏（只查不改，约 5–15 分钟）。需管理员权限；执行期间应用将等待完成",
      "requires_admin": true,
      "maintenance": true,
      "actions": [
        { "type": "exec", "program": "dism", "args": ["/Online", "/Cleanup-Image", "/ScanHealth"], "timeout_ms": 1800000 }
      ]
    },
    {
      "id": "maintenance_dism_restorehealth",
      "name": "DISM 组件存储修复",
      "category": "maintenance",
      "description": "DISM /RestoreHealth：修复组件存储损坏（需要联网下载完好组件，约 10–30 分钟）。需管理员权限",
      "requires_admin": true,
      "maintenance": true,
      "actions": [
        { "type": "exec", "program": "dism", "args": ["/Online", "/Cleanup-Image", "/RestoreHealth"], "timeout_ms": 1800000 }
      ]
    },
    {
      "id": "maintenance_dism_component_cleanup",
      "name": "DISM 组件存储清理",
      "category": "maintenance",
      "description": "DISM /StartComponentCleanup：清理 WinSxS 旧版本组件（释放磁盘空间；清理后已装更新无法单独卸载）。需管理员权限",
      "requires_admin": true,
      "maintenance": true,
      "actions": [
        { "type": "exec", "program": "dism", "args": ["/Online", "/Cleanup-Image", "/StartComponentCleanup"], "timeout_ms": 1800000 }
