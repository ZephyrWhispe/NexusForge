        },
        {
          "type": "registry",
          "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "value_name": "SubscribedContent-338387Enabled",
          "value_type": "dword",
          "data": { "dword": 0 }
        },
        {
          "type": "registry",
          "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "value_name": "SubscribedContent-338388Enabled",
          "value_type": "dword",
          "data": { "dword": 0 }
