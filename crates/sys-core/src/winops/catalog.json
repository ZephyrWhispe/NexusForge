{
  "tweaks": [
    {
      "id": "taskbar_hide_widgets",
      "name": "隐藏任务栏小组件",
      "category": "taskbar",
      "description": "移除任务栏左侧的天气/资讯小组件按钮（Win11 22000+）",
      "actions": [
        {
          "type": "registry",
          "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value_name": "TaskbarDa",
          "value_type": "dword",
          "data": { "dword": 0 }
        }
      ]
    },
    {
      "id": "taskbar_hide_chat",
      "name": "隐藏任务栏聊天图标",
      "category": "taskbar",
      "description": "移除任务栏 Teams 聊天图标（Win11 22000+）",
      "actions": [
        {
          "type": "registry",
          "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value_name": "TaskbarMn",
          "value_type": "dword",
          "data": { "dword": 0 }
        }
      ]
    },
