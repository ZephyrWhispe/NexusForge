            "password": "p1",
            "port": 8388
          }
        ]
      },
      "tag": "sub0aaaa:hk-1"
    },
    {
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "example.com",
            "password": "p2",
            "port": 443
          }
        ]
      },
      "streamSettings": {
        "security": "tls",
        "tlsSettings": {
          "serverName": "example.com"
        }
      },
      "tag": "sub0aaaa:tokyo-2"
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "5.6.7.8",
            "port": 8443,
            "users": [
              {
                "encryption": "none",
                "flow": "xtls-rprx-vision",
                "id": "c0ee752e-de1a-4fde-a6bf-0f04b1c9d6e3"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
