        "tlsSettings": {
          "serverName": "cdn.example.net"
        },
        "wsSettings": {
          "path": "/rain"
        }
      },
      "tag": "sub1bbbb:lg-vless"
    },
    {
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "9.9.9.9",
            "port": 2053,
            "users": [
              {
                "alterId": 0,
                "id": "8a4c2b1e-3f60-4a2d-9e5b-7c1d0f2a3b4c",
                "security": "auto"
