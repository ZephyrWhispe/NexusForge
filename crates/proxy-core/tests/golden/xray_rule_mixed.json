{
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 7890,
      "protocol": "http",
      "tag": "http-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 7891,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "tag": "socks-in"
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "shadowsocks",
      "settings": {
        "servers": [
          {
            "address": "1.2.3.4",
