{
  "dns": {
    "final": "remote",
    "rules": [
      {
        "outbound": "any",
        "server": "local"
      }
    ],
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "detour": "proxy",
        "tag": "remote"
      },
      {
        "address": "local",
        "detour": "direct",
        "tag": "local"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
