    },
    {
      "method": "aes-256-gcm",
      "password": "p1",
      "server": "1.2.3.4",
      "server_port": 8388,
      "tag": "sub0aaaa:hk-1",
      "type": "shadowsocks"
    },
    {
      "password": "p2",
      "server": "example.com",
      "server_port": 443,
      "tag": "sub0aaaa:tokyo-2",
      "tls": {
        "enabled": true,
        "server_name": "example.com"
      },
      "type": "trojan"
    },
    {
      "flow": "xtls-rprx-vision",
      "server": "5.6.7.8",
      "server_port": 8443,
      "tag": "sub1bbbb:lg-vless",
      "tls": {
        "enabled": true,
        "server_name": "cdn.example.net"
      },
      "transport": {
        "path": "/rain",
        "type": "ws"
      },
      "type": "vless",
      "uuid": "c0ee752e-de1a-4fde-a6bf-0f04b1c9d6e3"
    },
    {
      "alter_id": 0,
      "security": "auto",
      "server": "9.9.9.9",
